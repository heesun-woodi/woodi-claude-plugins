# 이미지 생성 AI 키 — 아래 두 키 중 가진 것 하나만 채우면 됩니다.
# 키는 이 파일(.env)에만 적고, 채팅에 붙여넣지 마세요. .env는 커밋하지 않습니다.
# 확인: python3 scripts/check_image_key.py  (이미지를 만들지 않는 무료 조회)

# 제공자(선택): gemini 또는 openai. 비우면 GEMINI_API_KEY가 있으면 gemini, 없고 OPENAI_API_KEY가 있으면 openai.
# 지정하면 그 제공자의 키만 씁니다(키가 비었으면 다른 키로 넘어가지 않고 오류).
IMAGE_PROVIDER=

# Gemini API 키. 발급: https://aistudio.google.com/apikey (결제(Billing)가 설정된 프로젝트의 키여야 이미지 생성 가능)
GEMINI_API_KEY=

# OpenAI API 키(GPT 이미지). 발급: https://platform.openai.com/api-keys
# 조직 인증(Verify Organization)이 필요할 수 있습니다 — platform.openai.com 설정에서 확인
OPENAI_API_KEY=

# 모델(선택): 비우면 제공자 기본값(gemini=gemini-3-pro-image, openai=gpt-image-2)
# IMAGE_MODEL=

# 네이버 블로그 아이디(필수): blog.naver.com/<아이디> 의 <아이디>. 비우면 업로드(naver_upload.sh, --blog-id가 없을 때)와
# 글 검사의 관련글 링크 확인(lint_post.py final·upload 단계)이 오류로 멈춥니다.
NAVER_BLOG_ID=

# 스톡 사진 제공자(선택): openverse 또는 pexels. 프로필 `이미지 소스`에 stock이 있을 때 쓰입니다.
# 비우면 PEXELS_API_KEY가 있으면 pexels, 없으면 openverse(키 필요 없음 — CC0·퍼블릭 도메인 사진만).
# 지정한 값이 둘 중 하나가 아니거나, pexels인데 PEXELS_API_KEY가 비어 있으면 오류(다른 제공자로 넘어가지 않음).
# 확인: python3 scripts/check_image_key.py --stock
STOCK_PROVIDER=

# 선택 — 이미 키가 있을 때, 신규 발급 일시 중단(Pexels가 새 API 키 발급을 멈췄습니다). 없어도 Openverse로 스톡 사진을 받을 수 있습니다.
# 기존 키 발급처: https://www.pexels.com/api/ . Pexels 라이선스는 출처 표기 의무가 없습니다(표기는 권장 — fetch_stock.py가 image-plan에 출처를 적어 둡니다).
# 키는 이 파일(.env)에만 적고 채팅에 붙여넣지 마세요.
PEXELS_API_KEY=
